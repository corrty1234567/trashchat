DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Server-only session signing secret; visitors do not enter a username or password.
# Keep the existing variable name. Use a private random value of at least 16 characters.
# Missing, short, or example values disable website and API access.
# AUTH_USER is an optional signing namespace, not a visitor account.
TRASHCHAT_AUTH_USER="trashchat"
TRASHCHAT_AUTH_PASSWORD="change-this-password"

# Required for encrypted realtime, image uploads and migration. Generate once with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep this key backed up; changing it makes existing encrypted images unreadable.
TRASHCHAT_DATA_KEY=""

# Vercel Blob, used by /api/upload for image messages.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxx"

# Pusher Channels, used for session-authorized private realtime sync.
PUSHER_APP_ID="0000000"
PUSHER_SECRET="xxxxxxxxxxxxxxxxxxxx"
PUSHER_CLUSTER="ap3"
NEXT_PUBLIC_PUSHER_KEY="xxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_PUSHER_CLUSTER="ap3"
